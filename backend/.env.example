PORT=3000

# vivo AIGC — 复制为 .env 后填写（勿提交 Git）
VIVO_AIGC_APP_ID=你的AppID
VIVO_AIGC_APP_KEY=你的AppKey
# 兼容旧变量名
VIVO_APP_KEY=你的AppKey
# 可选
VIVO_VAID=123456789

# 推荐：false = 实拍 FFmpeg 拼接 + 蓝心 Chat 旁白
# true  = 额外调用视频生成 API（每日 5 次，仅 demo）
VIVO_USE_VIDEO_GEN=false

VIVO_AIGC_BASE_URL=https://api-ai.vivo.com.cn
VIVO_AIGC_CHAT_PATH=/v1/chat/completions
VIVO_AIGC_CHAT_MODEL=Doubao-Seed-2.0-mini
VIVO_IMAGE_PATH=/api/v1/image_generation
VIVO_IMAGE_MODEL=Doubao-Seedream-4.5
VIVO_VIDEO_MODEL=Doubao-Seedance-1.0-pro

# vivo TTS 旁白
VIVO_TTS_ENABLED=true
VIVO_TTS_ENGINEID=short_audio_synthesis_jovi
VIVO_TTS_GATEWAY_SIGNATURE=developers-aigc

# vivo 通用 OCR（默认关闭）
VIVO_OCR_ENABLED=false
